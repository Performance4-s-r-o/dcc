<?xml version='1.0' encoding='UTF-8'?>
<dcc:digitalCalibrationCertificate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dcc="https://ptb.de/dcc" xmlns:si="https://ptb.de/si" xsi:schemaLocation="https://ptb.de/dcc https://ptb.de/dcc/v3.2.1/dcc.xsd" schemaVersion="3.2.1">
    <dcc:administrativeData>
        <dcc:dccSoftware>
            <dcc:software>
                <dcc:name>
                    <dcc:content lang="cs">Excel</dcc:content>
                </dcc:name>
                <dcc:release>v8.2</dcc:release>
            </dcc:software>
            <dcc:software>
                <dcc:name>
                    <dcc:content lang="cs">Sablona digitalni teplomer s termoclankovou sondou</dcc:content>
                </dcc:name>
                <dcc:release>v1.0</dcc:release>
            </dcc:software>
        </dcc:dccSoftware>
        <dcc:calibrationLaboratory>
            <dcc:calibrationLaboratoryCode>{{calibration_lab_code}}</dcc:calibrationLaboratoryCode>
            <dcc:contact>
                <dcc:name>
                    <dcc:content lang="cs">{{laboratory_name}}</dcc:content>
                </dcc:name>
                <dcc:eMail>{{laboratory_email}}</dcc:eMail>
                <dcc:location>
                    <dcc:city>{{laboratory_city}}</dcc:city>
                    <dcc:countryCode>CZ</dcc:countryCode>
                </dcc:location>
            </dcc:contact>
        </dcc:calibrationLaboratory>
        <dcc:coreData>
            <dcc:countryCodeISO3166_1>CZ</dcc:countryCodeISO3166_1>
            <dcc:usedLangCodeISO639_1>cs</dcc:usedLangCodeISO639_1>
            <dcc:mandatoryLangCodeISO639_1>cs</dcc:mandatoryLangCodeISO639_1>
            <dcc:uniqueIdentifier>{{lab_unique_identifier}}</dcc:uniqueIdentifier>
            <dcc:identifications>
                <dcc:identification>
                    <dcc:issuer>calibrationLaboratory</dcc:issuer>
                    <dcc:value>{{lab_identifier}}</dcc:value>
                </dcc:identification>
            </dcc:identifications>
            <dcc:beginPerformanceDate>{{calibration_start_date}}</dcc:beginPerformanceDate>
            <dcc:endPerformanceDate>{{calibration_end_date}}</dcc:endPerformanceDate>
            <dcc:performanceLocation>{{calibration_location}}</dcc:performanceLocation>
            <dcc:issueDate>{{issue_date}}</dcc:issueDate>
        </dcc:coreData>
        <dcc:customer>
            <dcc:name>
                <dcc:content lang="cs">{{customer_name}}</dcc:content>
            </dcc:name>
            <dcc:location>
                <dcc:countryCode>{{customer_country_code}}</dcc:countryCode>
                <dcc:city>{{customer_city}}</dcc:city>
            </dcc:location>
        </dcc:customer>
        <dcc:items>
            <dcc:item>
                <dcc:name>
                    <dcc:content lang="cs">{{instrument_name}}</dcc:content>
                </dcc:name>
                <dcc:description>
                    <dcc:content lang="cs">{{instrument_description}}</dcc:content>
                </dcc:description>
                <dcc:manufacturer>
                    <dcc:name>
                        <dcc:content lang="cs">{{manufacturer_name}}</dcc:content>
                    </dcc:name>
                </dcc:manufacturer>
                <dcc:model>{{model}}</dcc:model>
                <dcc:identifications>
                    <dcc:identification refType="basic_serialNumber">
                        <dcc:issuer>manufacturer</dcc:issuer>
                        <dcc:value>{{serial_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content lang="cs">Výr. č.</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                    <dcc:identification refType="basic_identificationNumber">
                        <dcc:issuer>customer</dcc:issuer>
                        <dcc:value>{{inventory_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content lang="cs">Evidenční číslo</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                    <dcc:identification>
                        <dcc:issuer>manufacturer</dcc:issuer>
                        <dcc:value>{{probe_serial_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content lang="cs">Výrobní číslo sondy</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                </dcc:identifications>
                <dcc:itemQuantities>
                    <dcc:itemQuantity refType="basic_resolution">
                        <dcc:name>
                            <dcc:content lang="cs">Rozlišení</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{resolution_degc}}</si:value>
                            <si:unit>\degreecelsius</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                </dcc:itemQuantities>
            </dcc:item>
        </dcc:items>
        <dcc:respPersons>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content lang="cs">{{responsible_person_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Calibrated by</dcc:role>
            </dcc:respPerson>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content lang="cs">{{approver_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Approved by</dcc:role>
            </dcc:respPerson>
        </dcc:respPersons>
        <dcc:statements>
            <dcc:statement>
                <dcc:declaration>
                    <dcc:content lang="cs">{{results_declaration}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Místo kalibrace</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{calibration_location_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Metrologická návaznost</dcc:content>
                </dcc:name>
                <dcc:traceable>true</dcc:traceable>
                <dcc:declaration>
                    <dcc:content lang="cs">{{traceability}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Nejistota měření</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{uncertainty_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Uživatel měřidla</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{instrument_user_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Podmínky kalibrace</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{calibration_conditions_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
        </dcc:statements>
    </dcc:administrativeData>
    <dcc:measurementResults>
        <dcc:measurementResult>
            <dcc:name>
                <dcc:content lang="cs">Výsledky měření</dcc:content>
            </dcc:name>
            <dcc:usedMethods>
                <dcc:usedMethod>
                    <dcc:name>
                        <dcc:content lang="cs">{{method_text}}</dcc:content>
                    </dcc:name>
                    <dcc:reference>{{method_code}}</dcc:reference>
                </dcc:usedMethod>
            </dcc:usedMethods>
            <dcc:measuringEquipments>
                <dcc:measuringEquipment>
                    <dcc:name>
                        <dcc:content lang="cs">{{etalon_name}}</dcc:content>
                    </dcc:name>
                </dcc:measuringEquipment>
            </dcc:measuringEquipments>
            <dcc:influenceConditions>
                <dcc:influenceCondition refType="basic_temperature">
                    <dcc:name>
                        <dcc:content lang="cs">Teplota v laboratoři</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity refType="math_minimum">
                            <dcc:name>
                                <dcc:content lang="cs">Teplota v laboratoři min</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{ambient_temperature_min_degc}}</si:value>
                                <si:unit>\degreecelsius</si:unit>
                            </si:real>
                        </dcc:quantity>
                        <dcc:quantity refType="math_maximum">
                            <dcc:name>
                                <dcc:content lang="cs">Teplota v laboratoři max</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{ambient_temperature_max_degc}}</si:value>
                                <si:unit>\degreecelsius</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
                <dcc:influenceCondition refType="gp_immersionDepth">
                    <dcc:name>
                        <dcc:content lang="cs">Ponor 1</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity>
                            <dcc:name>
                                <dcc:content lang="cs">Ponor 1</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{immersion_depth_1_m}}</si:value>
                                <si:unit>\metre</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
                <dcc:influenceCondition refType="gp_immersionDepth">
                    <dcc:name>
                        <dcc:content lang="cs">Ponor 2</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity>
                            <dcc:name>
                                <dcc:content lang="cs">Ponor 2</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{immersion_depth_2_m}}</si:value>
                                <si:unit>\metre</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
            </dcc:influenceConditions>
            <dcc:results>
                <dcc:result>
                    <dcc:name>
                        <dcc:content lang="cs">Výsledek měření při ponoru 1</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity refType="basic_referenceValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Teplota etalonu t90</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{reference_values_depth_1_degc}}</si:valueXMLList>
                                    <si:unitXMLList>\degreecelsius</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measuredValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Teplota indikovaná měřidlem tm</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{measured_values_depth_1_degc}}</si:valueXMLList>
                                    <si:unitXMLList>\degreecelsius</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_uncertainty">
                                <dcc:name>
                                    <dcc:content lang="cs">Rozšířená nejistota U</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{uncertainties_depth_1_degc}}</si:valueXMLList>
                                    <si:unitXMLList>\degreecelsius</si:unitXMLList>
                                    <si:expandedUncXMLList>
                                        <si:uncertaintyXMLList>{{uncertainties_depth_1_degc}}</si:uncertaintyXMLList>
                                        <si:coverageFactorXMLList>{{coverage_factor_depth_1}}</si:coverageFactorXMLList>
                                        <si:coverageProbabilityXMLList>{{coverage_probability_depth_1}}</si:coverageProbabilityXMLList>
                                    </si:expandedUncXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
                <dcc:result>
                    <dcc:name>
                        <dcc:content lang="cs">Výsledek měření při ponoru 2</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity refType="basic_referenceValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Teplota etalonu t90</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{reference_values_depth_2_degc}}</si:valueXMLList>
                                    <si:unitXMLList>\degreecelsius</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measuredValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Teplota indikovaná měřidlem tm</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{measured_values_depth_2_degc}}</si:valueXMLList>
                                    <si:unitXMLList>\degreecelsius</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_uncertainty">
                                <dcc:name>
                                    <dcc:content lang="cs">Rozšířená nejistota U</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{uncertainties_depth_2_degc}}</si:valueXMLList>
                                    <si:unitXMLList>\degreecelsius</si:unitXMLList>
                                    <si:expandedUncXMLList>
                                        <si:uncertaintyXMLList>{{uncertainties_depth_2_degc}}</si:uncertaintyXMLList>
                                        <si:coverageFactorXMLList>{{coverage_factor_depth_2}}</si:coverageFactorXMLList>
                                        <si:coverageProbabilityXMLList>{{coverage_probability_depth_2}}</si:coverageProbabilityXMLList>
                                    </si:expandedUncXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
                <dcc:result>
                    <dcc:name>
                        <dcc:content lang="cs">Korekční konstanty měřidla</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content lang="cs">Základní hodnota (posun)</dcc:content>
                                </dcc:name>
                                <si:real>
                                    <si:value>{{correction_offset_degc}}</si:value>
                                    <si:unit>\degreecelsius</si:unit>
                                </si:real>
                            </dcc:quantity>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content lang="cs">Faktor</dcc:content>
                                </dcc:name>
                                <si:real>
                                    <si:value>{{correction_factor}}</si:value>
                                    <si:unit>\one</si:unit>
                                </si:real>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
            </dcc:results>
        </dcc:measurementResult>
    </dcc:measurementResults>
</dcc:digitalCalibrationCertificate>

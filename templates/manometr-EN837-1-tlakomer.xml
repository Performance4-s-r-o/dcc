<?xml version="1.0" encoding="UTF-8"?>
<dcc:digitalCalibrationCertificate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:dcc="https://ptb.de/dcc" xmlns:si="https://ptb.de/si"
    xsi:schemaLocation="https://ptb.de/dcc https://ptb.de/dcc/v3.2.1/dcc.xsd" schemaVersion="3.2.1">
    <dcc:administrativeData>
        <dcc:dccSoftware>
            <dcc:software>
                <dcc:name>
                    <dcc:content>Excel</dcc:content>
                </dcc:name>
                <dcc:release>v8.2</dcc:release>
            </dcc:software>
            <dcc:software>
                <dcc:name>
                    <dcc:content>Sablona manometr EN 837-1</dcc:content>
                </dcc:name>
                <dcc:release>v1.0</dcc:release>
            </dcc:software>
        </dcc:dccSoftware>
        <dcc:calibrationLaboratory>
            <dcc:calibrationLaboratoryCode>{{calibration_lab_code}}</dcc:calibrationLaboratoryCode>
            <dcc:contact>
                <dcc:name>
                    <dcc:content>{{laboratory_name}}</dcc:content>
                </dcc:name>
                <dcc:eMail>{{laboratory_email}}</dcc:eMail>
                <dcc:location>
                    <dcc:city>{{laboratory_city}}</dcc:city>
                    <dcc:countryCode>CZ</dcc:countryCode>
                </dcc:location>
            </dcc:contact>
        </dcc:calibrationLaboratory>
        <dcc:coreData>
            <dcc:countryCodeISO3166_1>CZ</dcc:countryCodeISO3166_1>
            <dcc:usedLangCodeISO639_1>cs</dcc:usedLangCodeISO639_1>
            <dcc:mandatoryLangCodeISO639_1>cs</dcc:mandatoryLangCodeISO639_1>
            <dcc:uniqueIdentifier>{{lab_unique_identifier}}</dcc:uniqueIdentifier>
            <dcc:identifications>
                <dcc:identification>
                    <dcc:issuer>calibrationLaboratory</dcc:issuer>
                    <dcc:value>{{lab_identifier}}</dcc:value>
                </dcc:identification>
                <dcc:identification refType="documentForm">
                    <dcc:issuer>calibrationLaboratory</dcc:issuer>
                    <dcc:value>{{form_code}}</dcc:value>
                    <dcc:name>
                        <dcc:content>Form code</dcc:content>
                    </dcc:name>
                </dcc:identification>
            </dcc:identifications>
            <dcc:receiptDate>{{receipt_date}}</dcc:receiptDate>
            <dcc:beginPerformanceDate>{{calibration_start_date}}</dcc:beginPerformanceDate>
            <dcc:endPerformanceDate>{{calibration_end_date}}</dcc:endPerformanceDate>
            <dcc:performanceLocation>{{calibration_location}}</dcc:performanceLocation>
            <dcc:issueDate>{{issue_date}}</dcc:issueDate>
        </dcc:coreData>
        <dcc:customer>
            <dcc:name>
                <dcc:content>{{customer_name}}</dcc:content>
            </dcc:name>
            <dcc:eMail>{{customer_email}}</dcc:eMail>
            <dcc:phone>{{customer_phone}}</dcc:phone>
            <dcc:location>
                <dcc:countryCode>{{customer_country_code}}</dcc:countryCode>
                <dcc:city>{{customer_city}}</dcc:city>
            </dcc:location>
        </dcc:customer>
        <dcc:items>
            <dcc:item>
                <dcc:name>
                    <dcc:content>{{instrument_name}}</dcc:content>
                </dcc:name>
                <dcc:equipmentClass>
                    <dcc:reference>{{instrument_reference_class}}</dcc:reference>
                    <dcc:classID>{{reference_class_id}}</dcc:classID>
                </dcc:equipmentClass>
                <dcc:description>
                    <dcc:content>Pressure medium: {{medium}}</dcc:content>
                </dcc:description>
                <dcc:manufacturer>
                    <dcc:name>
                        <dcc:content>{{manufacturer_name}}</dcc:content>
                    </dcc:name>
                </dcc:manufacturer>
                <dcc:model>{{model}}</dcc:model>
                <dcc:identifications>
                    <dcc:identification refType="serialNumber">
                        <dcc:issuer>manufacturer</dcc:issuer>
                        <dcc:value>{{serial_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content>SN</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                    <dcc:identification refType="inventoryNumber">
                        <dcc:issuer>customer</dcc:issuer>
                        <dcc:value>{{inventory_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content>Inventory number</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                </dcc:identifications>
                <dcc:itemQuantities>
                    <dcc:itemQuantity refType="toleranceLimitUpper">
                        <dcc:name>
                            <dcc:content>MPE relative upper</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{mpe_relative_upper}}</si:value>
                            <si:unit>\percent</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity refType="toleranceLimitLower">
                        <dcc:name>
                            <dcc:content>MPE relative lower</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{mpe_relative_lower}}</si:value>
                            <si:unit>\percent</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity refType="basic_rangeLower">
                        <dcc:name>
                            <dcc:content>Measuring range lower limit</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{range_lower}}</si:value>
                            <si:unit>{{measurement_si_unit}}</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity refType="basic_rangeUpper">
                        <dcc:name>
                            <dcc:content>Measuring range upper limit</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{range_upper}}</si:value>
                            <si:unit>{{measurement_si_unit}}</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity refType="basic_resolution">
                        <dcc:name>
                            <dcc:content>Scale division</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{scale_division}}</si:value>
                            <si:unit>{{measurement_si_unit}}</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                </dcc:itemQuantities>
            </dcc:item>
        </dcc:items>
        <dcc:respPersons>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content>{{responsible_person_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Calibrated by</dcc:role>
            </dcc:respPerson>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content>{{approver_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Approved by (head of laboratory)</dcc:role>
            </dcc:respPerson>
        </dcc:respPersons>
        <dcc:statements>
            <dcc:statement>
                <dcc:declaration>
                    <dcc:content>{{results_declaration}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Place of calibration</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content>{{calibration_location_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Traceability</dcc:content>
                </dcc:name>
                <dcc:traceable>true</dcc:traceable>
                <dcc:declaration>
                    <dcc:content>{{traceability}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Adjustment</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content>{{adjustment_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Notes to the results table</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content>{{notes_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Measurement uncertainty</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content>{{uncertainty_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Decision rule</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content>{{decision_rule}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Conformity of calibration points</dcc:content>
                </dcc:name>
                <dcc:conformityXMLList>{{conformity_values}}</dcc:conformityXMLList>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Conclusion</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content>{{conclusion_text}}</dcc:content>
                </dcc:declaration>
                <dcc:conformity>{{overall_conformity}}</dcc:conformity>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content>Summary of results</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content>{{conclusion_values}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
        </dcc:statements>
    </dcc:administrativeData>
    <dcc:measurementResults>
        <dcc:measurementResult>
            <dcc:name>
                <dcc:content>Measurement results</dcc:content>
            </dcc:name>
            <dcc:usedMethods>
                <dcc:usedMethod>
                    <dcc:name>
                        <dcc:content>{{method_text}}</dcc:content>
                    </dcc:name>
                    <dcc:norm>EN 837-1</dcc:norm>
                    <dcc:reference>EURAMET Calibration Guide No. 17</dcc:reference>
                </dcc:usedMethod>
            </dcc:usedMethods>
            <dcc:measuringEquipments>
                <dcc:measuringEquipment>
                    <dcc:name>
                        <dcc:content>{{etalon_name}}</dcc:content>
                    </dcc:name>
                </dcc:measuringEquipment>
            </dcc:measuringEquipments>
            <dcc:influenceConditions>
                <dcc:influenceCondition refType="basic_temperature">
                    <dcc:name>
                        <dcc:content>Ambient temperature at start and end of measurement</dcc:content>
                    </dcc:name>
                    <dcc:data>            <!-- Start temperature (with timestamp) -->
                        <dcc:list>
                            <dcc:dateTime>{{measurement_start_datetime}}</dcc:dateTime>
                            <dcc:quantity refType="basic_temperature">
                                <dcc:name>
                                    <dcc:content>Ambient temperature at start</dcc:content>
                                </dcc:name>
                                <si:real>
                                    <si:value>{{ambient_temperature_start}}</si:value>
                                    <si:unit>\degreecelsius</si:unit>
                                </si:real>
                            </dcc:quantity>
                        </dcc:list>            <!--
                        End temperature (with timestamp) -->
                        <dcc:list>
                            <dcc:dateTime>{{measurement_end_datetime}}</dcc:dateTime>
                            <dcc:quantity refType="basic_temperature">
                                <dcc:name>
                                    <dcc:content>Ambient temperature at end</dcc:content>
                                </dcc:name>
                                <si:real>
                                    <si:value>{{ambient_temperature_end}}</si:value>
                                    <si:unit>\degreecelsius</si:unit>
                                </si:real>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:influenceCondition>
                <dcc:influenceCondition refType="basic_pressure">
                    <dcc:name>
                        <dcc:content>Atmospheric pressure</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity refType="basic_pressure">
                            <dcc:name>
                                <dcc:content>Atmospheric pressure</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{pressure_hpa}}</si:value>
                                <si:unit>\hecto\pascal</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
                <dcc:influenceCondition refType="basic_humidityRelative">
                    <dcc:name>
                        <dcc:content>Relative humidity</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity refType="basic_humidityRelative">
                            <dcc:name>
                                <dcc:content>Relative humidity</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{humidity_pct}}</si:value>
                                <si:unit>\percent</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
                <dcc:influenceCondition refType="basic_heightDifference">
                    <dcc:name>
                        <dcc:content>Height difference of reference levels (etalon minus calibrated instrument)</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity refType="basic_heightDifference">
                            <dcc:name>
                                <dcc:content>Height difference of reference levels (etalon minus calibrated instrument)</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{height_difference}}</si:value>
                                <si:unit>\metre</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
            </dcc:influenceConditions>
            <dcc:results>
                <dcc:result>
                    <dcc:name>
                        <dcc:content>Measurement result</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity refType="basic_referenceValue">
                                <dcc:name>
                                    <dcc:content>Reference value</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{reference_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measuredValue">
                                <dcc:name>
                                    <dcc:content>Indicated values on the calibrated instrument</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                        <si:valueXMLList>{{measured_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                    <si:expandedUncXMLList>
                                        <si:uncertaintyXMLList>{{measured_uncertainties}}</si:uncertaintyXMLList>
                                        <si:coverageFactorXMLList>{{coverage_factor}}</si:coverageFactorXMLList>
                                        <si:coverageProbabilityXMLList>{{coverage_probability}}</si:coverageProbabilityXMLList>
                                    </si:expandedUncXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="measurementError">
                                <dcc:name>
                                    <dcc:content>Absolute measurement error</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{measurement_errors}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
                <dcc:result>
                    <dcc:name>
                        <dcc:content>Repeatability</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity>
                            <dcc:name>
                                <dcc:content>Repeatability</dcc:content>
                            </dcc:name>
                            <si:realListXMLList>
                                <si:valueXMLList>{{repeatability_values}}</si:valueXMLList>
                                <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                            </si:realListXMLList>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:result>
                <dcc:result>
                    <dcc:name>
                        <dcc:content>Results per calibration point</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content>Mean reference value (corrected to the reference level of the instrument)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{mean_reference_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content>Mean error (mean indication minus mean reference value)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{mean_error_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content>Hysteresis</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{hysteresis_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content>Error span U' (reported uncertainty plus absolute mean error)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{error_span_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="toleranceLimitUpper">
                                <dcc:name>
                                    <dcc:content>Maximum permissible error (plus/minus)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{mpe_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{measurement_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
            </dcc:results>
        </dcc:measurementResult>
    </dcc:measurementResults>
</dcc:digitalCalibrationCertificate>
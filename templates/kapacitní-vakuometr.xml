<?xml version='1.0' encoding='UTF-8'?>
<dcc:digitalCalibrationCertificate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dcc="https://ptb.de/dcc" xmlns:si="https://ptb.de/si" xsi:schemaLocation="https://ptb.de/dcc https://ptb.de/dcc/v3.3.0/dcc.xsd" schemaVersion="3.3.0">
    <dcc:administrativeData>
        <dcc:dccSoftware>
            <dcc:software>
                <dcc:name>
                    <dcc:content lang="cs">Excel</dcc:content>
                </dcc:name>
                <dcc:release>v8.2</dcc:release>
            </dcc:software>
            <dcc:software>
                <dcc:name>
                    <dcc:content lang="cs">Sablona kapacitni vakuometr</dcc:content>
                </dcc:name>
                <dcc:release>v1.1</dcc:release>
            </dcc:software>
        </dcc:dccSoftware>
        <dcc:calibrationLaboratory>
            <dcc:calibrationLaboratoryCode>{{calibration_lab_code}}</dcc:calibrationLaboratoryCode>
            <dcc:contact>
                <dcc:name>
                    <dcc:content lang="cs">{{laboratory_name}}</dcc:content>
                </dcc:name>
                <dcc:eMail>{{laboratory_email}}</dcc:eMail>
                <dcc:location>
                    <dcc:city>{{laboratory_city}}</dcc:city>
                    <dcc:countryCode>CZ</dcc:countryCode>
                </dcc:location>
            </dcc:contact>
        </dcc:calibrationLaboratory>
        <dcc:coreData>
            <dcc:countryCodeISO3166_1>CZ</dcc:countryCodeISO3166_1>
            <dcc:usedLangCodeISO639_1>cs</dcc:usedLangCodeISO639_1>
            <dcc:mandatoryLangCodeISO639_1>cs</dcc:mandatoryLangCodeISO639_1>
            <dcc:uniqueIdentifier>{{lab_unique_identifier}}</dcc:uniqueIdentifier>
            <dcc:identifications>
                <dcc:identification>
                    <dcc:issuer>calibrationLaboratory</dcc:issuer>
                    <dcc:value>{{lab_identifier}}</dcc:value>
                </dcc:identification>
            </dcc:identifications>
            <dcc:beginPerformanceDate>{{calibration_start_date}}</dcc:beginPerformanceDate>
            <dcc:endPerformanceDate>{{calibration_end_date}}</dcc:endPerformanceDate>
            <dcc:performanceLocation>{{calibration_location}}</dcc:performanceLocation>
            <dcc:issueDate>{{issue_date}}</dcc:issueDate>
        </dcc:coreData>
        <dcc:customer>
            <dcc:name>
                <dcc:content lang="cs">{{customer_name}}</dcc:content>
            </dcc:name>
            <dcc:location>
                <dcc:countryCode>{{customer_country_code}}</dcc:countryCode>
                <dcc:city>{{customer_city}}</dcc:city>
            </dcc:location>
        </dcc:customer>
        <dcc:items>
            <dcc:item>
                <dcc:name>
                    <dcc:content lang="cs">{{instrument_name}}</dcc:content>
                </dcc:name>
                <dcc:manufacturer>
                    <dcc:name>
                        <dcc:content lang="cs">{{manufacturer_name}}</dcc:content>
                    </dcc:name>
                </dcc:manufacturer>
                <dcc:model>{{model}}</dcc:model>
                <dcc:identifications>
                    <dcc:identification refType="basic_serialNumber">
                        <dcc:issuer>manufacturer</dcc:issuer>
                        <dcc:value>{{serial_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content lang="cs">Výr. č.</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                    <dcc:identification refType="basic_identificationNumber">
                        <dcc:issuer>customer</dcc:issuer>
                        <dcc:value>{{inventory_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content lang="cs">Evidenční číslo</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                </dcc:identifications>
                <dcc:itemQuantities>
                    <dcc:itemQuantity refType="basic_rangeLower">
                        <dcc:name>
                            <dcc:content lang="cs">Dolní mez měřicího rozsahu</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{range_lower_pa}}</si:value>
                            <si:unit>\pascal</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity refType="basic_rangeUpper">
                        <dcc:name>
                            <dcc:content lang="cs">Horní mez měřicího rozsahu</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{range_upper_pa}}</si:value>
                            <si:unit>\pascal</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity>
                        <dcc:name>
                            <dcc:content lang="cs">Druh tlaku</dcc:content>
                        </dcc:name>
                        <dcc:noQuantity>
                            <dcc:content lang="cs">{{pressure_type_text}}</dcc:content>
                        </dcc:noQuantity>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity>
                        <dcc:name>
                            <dcc:content lang="cs">Dolní mez výstupního signálu</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{output_signal_lower}}</si:value>
                            <si:unit>{{output_si_unit}}</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity>
                        <dcc:name>
                            <dcc:content lang="cs">Horní mez výstupního signálu</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{output_signal_upper}}</si:value>
                            <si:unit>{{output_si_unit}}</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity refType="basic_resolution">
                        <dcc:name>
                            <dcc:content lang="cs">Rozlišení výstupního signálu</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{resolution_output}}</si:value>
                            <si:unit>{{output_si_unit}}</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                    <dcc:itemQuantity>
                        <dcc:name>
                            <dcc:content lang="cs">Specifikace (procenta měřené hodnoty)</dcc:content>
                        </dcc:name>
                        <si:real>
                            <si:value>{{specification_pct_of_reading}}</si:value>
                            <si:unit>\percent</si:unit>
                        </si:real>
                    </dcc:itemQuantity>
                </dcc:itemQuantities>
            </dcc:item>
        </dcc:items>
        <dcc:respPersons>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content lang="cs">{{responsible_person_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Calibrated by</dcc:role>
            </dcc:respPerson>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content lang="cs">{{approver_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Approved by</dcc:role>
            </dcc:respPerson>
        </dcc:respPersons>
        <dcc:statements>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Ujednání o vzájemném uznávání (CIPM MRA)</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{mra_statement_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:declaration>
                    <dcc:content lang="cs">{{results_declaration}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Místo kalibrace</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{calibration_location_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Metrologická návaznost</dcc:content>
                </dcc:name>
                <dcc:traceable>true</dcc:traceable>
                <dcc:declaration>
                    <dcc:content lang="cs">{{traceability}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Nejistota měření</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{uncertainty_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
        </dcc:statements>
    </dcc:administrativeData>
    <dcc:measurementResults>
        <dcc:measurementResult>
            <dcc:name>
                <dcc:content lang="cs">Výsledky měření</dcc:content>
            </dcc:name>
            <dcc:usedMethods>
                <dcc:usedMethod>
                    <dcc:name>
                        <dcc:content lang="cs">{{method_text}}</dcc:content>
                    </dcc:name>
                    <dcc:reference>{{method_code}}</dcc:reference>
                </dcc:usedMethod>
            </dcc:usedMethods>
            <dcc:measuringEquipments>
                <dcc:measuringEquipment refType="basic_measurementStandard">
                    <dcc:name>
                        <dcc:content lang="cs">{{etalon_1_name}}</dcc:content>
                    </dcc:name>
                    <dcc:identifications>
                        <dcc:identification refType="basic_serialNumber">
                            <dcc:issuer>manufacturer</dcc:issuer>
                            <dcc:value>{{etalon_1_serial_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Výr. č.</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                        <dcc:identification refType="basic_certificateNumber">
                            <dcc:issuer>other</dcc:issuer>
                            <dcc:value>{{etalon_1_certificate_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Kalibrační list</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                    </dcc:identifications>
                </dcc:measuringEquipment>
                <dcc:measuringEquipment refType="basic_measurementStandard">
                    <dcc:name>
                        <dcc:content lang="cs">{{etalon_2_name}}</dcc:content>
                    </dcc:name>
                    <dcc:identifications>
                        <dcc:identification refType="basic_serialNumber">
                            <dcc:issuer>manufacturer</dcc:issuer>
                            <dcc:value>{{etalon_2_serial_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Výr. č.</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                        <dcc:identification refType="basic_certificateNumber">
                            <dcc:issuer>other</dcc:issuer>
                            <dcc:value>{{etalon_2_certificate_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Kalibrační list</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                    </dcc:identifications>
                </dcc:measuringEquipment>
                <dcc:measuringEquipment refType="basic_measurementStandard">
                    <dcc:name>
                        <dcc:content lang="cs">{{etalon_3_name}}</dcc:content>
                    </dcc:name>
                    <dcc:identifications>
                        <dcc:identification refType="basic_serialNumber">
                            <dcc:issuer>manufacturer</dcc:issuer>
                            <dcc:value>{{etalon_3_serial_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Výr. č.</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                        <dcc:identification refType="basic_certificateNumber">
                            <dcc:issuer>other</dcc:issuer>
                            <dcc:value>{{etalon_3_certificate_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Kalibrační list</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                    </dcc:identifications>
                </dcc:measuringEquipment>
            </dcc:measuringEquipments>
            <dcc:influenceConditions>
                <dcc:influenceCondition refType="basic_temperature">
                    <dcc:name>
                        <dcc:content lang="cs">Teplota vzduchu</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity refType="math_minimum">
                            <dcc:name>
                                <dcc:content lang="cs">Teplota vzduchu min</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{ambient_temperature_min_degc}}</si:value>
                                <si:unit>\degreecelsius</si:unit>
                            </si:real>
                        </dcc:quantity>
                        <dcc:quantity refType="math_maximum">
                            <dcc:name>
                                <dcc:content lang="cs">Teplota vzduchu max</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{ambient_temperature_max_degc}}</si:value>
                                <si:unit>\degreecelsius</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
                <dcc:influenceCondition>
                    <dcc:name>
                        <dcc:content lang="cs">Tlakové médium</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:text>
                            <dcc:content lang="cs">{{medium_text}}</dcc:content>
                        </dcc:text>
                    </dcc:data>
                </dcc:influenceCondition>
            </dcc:influenceConditions>
            <dcc:results>
                <dcc:result>
                    <dcc:name>
                        <dcc:content lang="cs">Výsledek měření</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity refType="basic_referenceValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Referenční tlak Pe</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{reference_values_pa}}</si:valueXMLList>
                                    <si:unitXMLList>\pascal</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content lang="cs">Ideální výstupní signál IID</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{ideal_output_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{output_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measuredValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Výstupní signál Pz (zatěžování)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{measured_values_up}}</si:valueXMLList>
                                    <si:unitXMLList>{{output_si_unit}}</si:unitXMLList>
                                    <si:measurementUncertaintyUnivariateXMLList>
                                        <si:expandedMUXMLList>
                                            <si:valueExpandedMUXMLList>{{uncertainties_up}}</si:valueExpandedMUXMLList>
                                            <si:coverageFactorXMLList>{{coverage_factor}}</si:coverageFactorXMLList>
                                            <si:coverageProbabilityXMLList>{{coverage_probability}}</si:coverageProbabilityXMLList>
                                        </si:expandedMUXMLList>
                                    </si:measurementUncertaintyUnivariateXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measurementError">
                                <dcc:name>
                                    <dcc:content lang="cs">Odchylka (zatěžování)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{deviation_values_up}}</si:valueXMLList>
                                    <si:unitXMLList>{{output_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measuredValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Výstupní signál Pz (odlehčování)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{measured_values_down}}</si:valueXMLList>
                                    <si:unitXMLList>{{output_si_unit}}</si:unitXMLList>
                                    <si:measurementUncertaintyUnivariateXMLList>
                                        <si:expandedMUXMLList>
                                            <si:valueExpandedMUXMLList>{{uncertainties_down}}</si:valueExpandedMUXMLList>
                                            <si:coverageFactorXMLList>{{coverage_factor}}</si:coverageFactorXMLList>
                                            <si:coverageProbabilityXMLList>{{coverage_probability}}</si:coverageProbabilityXMLList>
                                        </si:expandedMUXMLList>
                                    </si:measurementUncertaintyUnivariateXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measurementError">
                                <dcc:name>
                                    <dcc:content lang="cs">Odchylka (odlehčování)</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{deviation_values_down}}</si:valueXMLList>
                                    <si:unitXMLList>{{output_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
                <dcc:result>
                    <dcc:name>
                        <dcc:content lang="cs">Přenosová charakteristika IID = K + Q·Pe</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity id="transfer_k">
                                <dcc:name>
                                    <dcc:content lang="cs">Koeficient K</dcc:content>
                                </dcc:name>
                                <si:real>
                                    <si:label>K</si:label>
                                    <si:value>{{transfer_coefficient_k}}</si:value>
                                    <si:unit>{{output_si_unit}}</si:unit>
                                </si:real>
                            </dcc:quantity>
                            <dcc:quantity id="transfer_q">
                                <dcc:name>
                                    <dcc:content lang="cs">Koeficient Q</dcc:content>
                                </dcc:name>
                                <si:real>
                                    <si:label>Q</si:label>
                                    <si:value>{{transfer_coefficient_q}}</si:value>
                                    <si:unit>{{output_si_unit}}\pascal\tothe{-1}</si:unit>
                                </si:real>
                            </dcc:quantity>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
            </dcc:results>
        </dcc:measurementResult>
    </dcc:measurementResults>
</dcc:digitalCalibrationCertificate>

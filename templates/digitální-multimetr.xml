<?xml version='1.0' encoding='UTF-8'?>
<dcc:digitalCalibrationCertificate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dcc="https://ptb.de/dcc" xmlns:si="https://ptb.de/si" xsi:schemaLocation="https://ptb.de/dcc https://ptb.de/dcc/v3.2.1/dcc.xsd" schemaVersion="3.2.1">
    <dcc:administrativeData>
        <dcc:dccSoftware>
            <dcc:software>
                <dcc:name>
                    <dcc:content lang="cs">Excel</dcc:content>
                </dcc:name>
                <dcc:release>v8.2</dcc:release>
            </dcc:software>
            <dcc:software>
                <dcc:name>
                    <dcc:content lang="cs">Sablona digitalni multimetr</dcc:content>
                </dcc:name>
                <dcc:release>v1.0</dcc:release>
            </dcc:software>
        </dcc:dccSoftware>
        <dcc:calibrationLaboratory>
            <dcc:calibrationLaboratoryCode>{{calibration_lab_code}}</dcc:calibrationLaboratoryCode>
            <dcc:contact>
                <dcc:name>
                    <dcc:content lang="cs">{{laboratory_name}}</dcc:content>
                </dcc:name>
                <dcc:eMail>{{laboratory_email}}</dcc:eMail>
                <dcc:location>
                    <dcc:city>{{laboratory_city}}</dcc:city>
                    <dcc:countryCode>CZ</dcc:countryCode>
                </dcc:location>
            </dcc:contact>
        </dcc:calibrationLaboratory>
        <dcc:coreData>
            <dcc:countryCodeISO3166_1>CZ</dcc:countryCodeISO3166_1>
            <dcc:usedLangCodeISO639_1>cs</dcc:usedLangCodeISO639_1>
            <dcc:mandatoryLangCodeISO639_1>cs</dcc:mandatoryLangCodeISO639_1>
            <dcc:uniqueIdentifier>{{lab_unique_identifier}}</dcc:uniqueIdentifier>
            <dcc:identifications>
                <dcc:identification>
                    <dcc:issuer>calibrationLaboratory</dcc:issuer>
                    <dcc:value>{{lab_identifier}}</dcc:value>
                </dcc:identification>
            </dcc:identifications>
            <dcc:beginPerformanceDate>{{calibration_start_date}}</dcc:beginPerformanceDate>
            <dcc:endPerformanceDate>{{calibration_end_date}}</dcc:endPerformanceDate>
            <dcc:performanceLocation>{{calibration_location}}</dcc:performanceLocation>
            <dcc:issueDate>{{issue_date}}</dcc:issueDate>
        </dcc:coreData>
        <dcc:customer>
            <dcc:name>
                <dcc:content lang="cs">{{customer_name}}</dcc:content>
            </dcc:name>
            <dcc:location>
                <dcc:countryCode>{{customer_country_code}}</dcc:countryCode>
                <dcc:city>{{customer_city}}</dcc:city>
            </dcc:location>
        </dcc:customer>
        <dcc:items>
            <dcc:item>
                <dcc:name>
                    <dcc:content lang="cs">{{instrument_name}}</dcc:content>
                </dcc:name>
                <dcc:manufacturer>
                    <dcc:name>
                        <dcc:content lang="cs">{{manufacturer_name}}</dcc:content>
                    </dcc:name>
                </dcc:manufacturer>
                <dcc:model>{{model}}</dcc:model>
                <dcc:identifications>
                    <dcc:identification refType="basic_serialNumber">
                        <dcc:issuer>manufacturer</dcc:issuer>
                        <dcc:value>{{serial_number}}</dcc:value>
                        <dcc:name>
                            <dcc:content lang="cs">Výr. č.</dcc:content>
                        </dcc:name>
                    </dcc:identification>
                </dcc:identifications>
            </dcc:item>
        </dcc:items>
        <dcc:respPersons>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content lang="cs">{{responsible_person_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Calibrated by</dcc:role>
            </dcc:respPerson>
            <dcc:respPerson>
                <dcc:person>
                    <dcc:name>
                        <dcc:content lang="cs">{{approver_name}}</dcc:content>
                    </dcc:name>
                </dcc:person>
                <dcc:role>Approved by</dcc:role>
            </dcc:respPerson>
        </dcc:respPersons>
        <dcc:statements>
            <dcc:statement>
                <dcc:declaration>
                    <dcc:content lang="cs">{{results_declaration}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Místo kalibrace</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{calibration_location_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Metrologická návaznost</dcc:content>
                </dcc:name>
                <dcc:traceable>true</dcc:traceable>
                <dcc:declaration>
                    <dcc:content lang="cs">{{traceability}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Nejistota měření</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{uncertainty_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Podmínky kalibrace</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{calibration_conditions_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Vyjádření o plnění specifikace</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{specification_statement_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
            <dcc:statement>
                <dcc:name>
                    <dcc:content lang="cs">Legenda stavů</dcc:content>
                </dcc:name>
                <dcc:declaration>
                    <dcc:content lang="cs">{{status_legend_text}}</dcc:content>
                </dcc:declaration>
            </dcc:statement>
        </dcc:statements>
    </dcc:administrativeData>
    <dcc:measurementResults>
        <dcc:measurementResult>
            <dcc:name>
                <dcc:content lang="cs">Výsledky měření</dcc:content>
            </dcc:name>
            <dcc:usedMethods>
                <dcc:usedMethod>
                    <dcc:name>
                        <dcc:content lang="cs">{{method_text}}</dcc:content>
                    </dcc:name>
                    <dcc:reference>{{method_code}}</dcc:reference>
                </dcc:usedMethod>
            </dcc:usedMethods>
            <dcc:measuringEquipments>
                <!-- REPEAT etalon -->
                <dcc:measuringEquipment refType="basic_measurementStandard">
                    <dcc:name>
                        <dcc:content lang="cs">{{etalon_name}}</dcc:content>
                    </dcc:name>
                    <dcc:identifications>
                        <dcc:identification refType="basic_serialNumber">
                            <dcc:issuer>manufacturer</dcc:issuer>
                            <dcc:value>{{etalon_serial_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Výr. č.</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                        <dcc:identification refType="basic_certificateNumber">
                            <dcc:issuer>other</dcc:issuer>
                            <dcc:value>{{etalon_certificate_number}}</dcc:value>
                            <dcc:name>
                                <dcc:content lang="cs">Kalibrační list</dcc:content>
                            </dcc:name>
                        </dcc:identification>
                    </dcc:identifications>
                </dcc:measuringEquipment>
                <!-- /REPEAT etalon -->
            </dcc:measuringEquipments>
            <dcc:influenceConditions>
                <dcc:influenceCondition refType="basic_temperature">
                    <dcc:name>
                        <dcc:content lang="cs">Teplota vzduchu</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity refType="math_minimum">
                            <dcc:name>
                                <dcc:content lang="cs">Teplota vzduchu min</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{ambient_temperature_min_degc}}</si:value>
                                <si:unit>\degreecelsius</si:unit>
                            </si:real>
                        </dcc:quantity>
                        <dcc:quantity refType="math_maximum">
                            <dcc:name>
                                <dcc:content lang="cs">Teplota vzduchu max</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{ambient_temperature_max_degc}}</si:value>
                                <si:unit>\degreecelsius</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
                <dcc:influenceCondition refType="basic_humidityRelative">
                    <dcc:name>
                        <dcc:content lang="cs">Relativní vlhkost</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:quantity refType="math_minimum">
                            <dcc:name>
                                <dcc:content lang="cs">Relativní vlhkost min</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{humidity_min_pct}}</si:value>
                                <si:unit>\percent</si:unit>
                            </si:real>
                        </dcc:quantity>
                        <dcc:quantity refType="math_maximum">
                            <dcc:name>
                                <dcc:content lang="cs">Relativní vlhkost max</dcc:content>
                            </dcc:name>
                            <si:real>
                                <si:value>{{humidity_max_pct}}</si:value>
                                <si:unit>\percent</si:unit>
                            </si:real>
                        </dcc:quantity>
                    </dcc:data>
                </dcc:influenceCondition>
            </dcc:influenceConditions>
            <dcc:results>
                <!-- REPEAT range_block -->
                <dcc:result>
                    <dcc:name>
                        <dcc:content lang="cs">{{function_name}}, {{range_name}}</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity refType="basic_referenceValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Referenční hodnota</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{reference_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measuredValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Naměřená hodnota</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{measured_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                    <si:expandedUncXMLList>
                                        <si:uncertaintyXMLList>{{uncertainties}}</si:uncertaintyXMLList>
                                        <si:coverageFactorXMLList>{{coverage_factor}}</si:coverageFactorXMLList>
                                        <si:coverageProbabilityXMLList>{{coverage_probability}}</si:coverageProbabilityXMLList>
                                    </si:expandedUncXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_acceptanceLimitLower">
                                <dcc:name>
                                    <dcc:content lang="cs">Dolní mez tolerance</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{lower_limits}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_acceptanceLimitUpper">
                                <dcc:name>
                                    <dcc:content lang="cs">Horní mez tolerance</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{upper_limits}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measurementError">
                                <dcc:name>
                                    <dcc:content lang="cs">Absolutní chyba</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{absolute_errors}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content lang="cs">Využití tolerance</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{tolerance_usage_pct}}</si:valueXMLList>
                                    <si:unitXMLList>\percent</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:measurementMetaData>
                                <dcc:metaData refType="basic_conformity">
                                    <dcc:declaration>
                                        <dcc:content lang="cs">Shoda naměřené hodnoty s tolerancí (nejistota není započtena)</dcc:content>
                                    </dcc:declaration>
                                    <dcc:conformityXMLList>{{status_values}}</dcc:conformityXMLList>
                                </dcc:metaData>
                            </dcc:measurementMetaData>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
                <!-- /REPEAT range_block -->
                <!-- REPEAT ac_range_block -->
                <dcc:result>
                    <dcc:name>
                        <dcc:content lang="cs">{{function_name}}, {{range_name}}</dcc:content>
                    </dcc:name>
                    <dcc:data>
                        <dcc:list>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content lang="cs">Frekvence</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{frequency_values_hz}}</si:valueXMLList>
                                    <si:unitXMLList>\hertz</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_referenceValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Referenční hodnota</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{reference_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measuredValue">
                                <dcc:name>
                                    <dcc:content lang="cs">Naměřená hodnota</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{measured_values}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                    <si:expandedUncXMLList>
                                        <si:uncertaintyXMLList>{{uncertainties}}</si:uncertaintyXMLList>
                                        <si:coverageFactorXMLList>{{coverage_factor}}</si:coverageFactorXMLList>
                                        <si:coverageProbabilityXMLList>{{coverage_probability}}</si:coverageProbabilityXMLList>
                                    </si:expandedUncXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_acceptanceLimitLower">
                                <dcc:name>
                                    <dcc:content lang="cs">Dolní mez tolerance</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{lower_limits}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_acceptanceLimitUpper">
                                <dcc:name>
                                    <dcc:content lang="cs">Horní mez tolerance</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{upper_limits}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity refType="basic_measurementError">
                                <dcc:name>
                                    <dcc:content lang="cs">Absolutní chyba</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{absolute_errors}}</si:valueXMLList>
                                    <si:unitXMLList>{{range_si_unit}}</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:quantity>
                                <dcc:name>
                                    <dcc:content lang="cs">Využití tolerance</dcc:content>
                                </dcc:name>
                                <si:realListXMLList>
                                    <si:valueXMLList>{{tolerance_usage_pct}}</si:valueXMLList>
                                    <si:unitXMLList>\percent</si:unitXMLList>
                                </si:realListXMLList>
                            </dcc:quantity>
                            <dcc:measurementMetaData>
                                <dcc:metaData refType="basic_conformity">
                                    <dcc:declaration>
                                        <dcc:content lang="cs">Shoda naměřené hodnoty s tolerancí (nejistota není započtena)</dcc:content>
                                    </dcc:declaration>
                                    <dcc:conformityXMLList>{{status_values}}</dcc:conformityXMLList>
                                </dcc:metaData>
                            </dcc:measurementMetaData>
                        </dcc:list>
                    </dcc:data>
                </dcc:result>
                <!-- /REPEAT ac_range_block -->
            </dcc:results>
        </dcc:measurementResult>
    </dcc:measurementResults>
</dcc:digitalCalibrationCertificate>
